{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Auditable RSI candidate proposal",
  "type": "object",
  "required": ["author", "source_case_ids", "baseline_tree_hash", "rationale", "risk", "edits"],
  "properties": {
    "author": {"type": "string", "minLength": 1},
    "source_case_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "baseline_tree_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "rationale": {"type": "string", "minLength": 1},
    "risk": {"type": "string", "minLength": 1},
    "edits": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["path", "content"], "properties": {"path": {"type": "string"}, "content": {"type": "string", "minLength": 1}}}}
  }
}
